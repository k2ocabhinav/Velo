{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "out/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": [
        "^test:unit"
      ],
      "outputs": []
    },
    "test:contracts": {
      "dependsOn": [
        "^test:contracts"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
